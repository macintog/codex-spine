#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");
const os = require("os");
const crypto = require("crypto");
const { spawn, spawnSync } = require("child_process");

const HOME = process.env.HOME || os.homedir();
const SCRIPT_DIR = path.dirname(fs.realpathSync(__filename));
const STATE_ROOT = path.join(HOME, ".cache", "qmd", "codex_chat", ".state");
const PROJECTS_DIR = path.join(STATE_ROOT, "projects");
const LATEST_PROJECT_KEY_FILE = path.join(STATE_ROOT, "latest_project_key.txt");
const SYNC_SCRIPT = path.join(HOME, ".local", "bin", "sync-codex-chat-qmd.sh");
const SYNC_LOCK_DIR = "/tmp/codex-chat-qmd-sync.lock";
const SYNC_LOCK_STALE_SECONDS = Number(process.env.MEMORY_SYNC_LOCK_STALE_SECONDS || process.env.LOCK_STALE_SECONDS || "300");
const SYNC_LOCK_OWNER_FILE = "owner.json";
const QMD_CLI = process.env.QMD_CLI || path.join(HOME, ".local", "bin", "qmd-codex");
const MANAGED_PROJECT_CHECKPOINT_BIN = path.join(HOME, ".local", "bin", "codex-project-checkpoint");
const REPO_PROJECT_CHECKPOINT_BIN = path.join(SCRIPT_DIR, "codex-project-checkpoint");
const PROJECT_CHECKPOINT_BIN = process.env.CODEX_PROJECT_CHECKPOINT_BIN
  || (fs.existsSync(MANAGED_PROJECT_CHECKPOINT_BIN) ? MANAGED_PROJECT_CHECKPOINT_BIN : REPO_PROJECT_CHECKPOINT_BIN);
const SQLITE3_BIN = process.env.SQLITE3_BIN || "sqlite3";
const DEFAULT_INDEX = process.env.QMD_DEFAULT_INDEX || "codex_chat";
const PROJECT_CACHE_ROOT = path.join(HOME, ".cache", "qmd", DEFAULT_INDEX);
const STALE_SECONDS = Number(process.env.MEMORY_STALE_SECONDS || "300");
const BOOTSTRAP_MAX_BYTES = Number(process.env.MEMORY_BOOTSTRAP_MAX_BYTES || "8000");
const BOOTSTRAP_EVENTS_FILE = path.join(STATE_ROOT, "bootstrap-events.jsonl");
const RAW_SESSION_MAX_LINE_BYTES = 1024 * 1024;
const RECENT_SESSION_DEFAULT_MAX_MESSAGES = 4;
const RECENT_SESSION_MAX_MESSAGES = 8;
const RECENT_SESSION_DEFAULT_MAX_BYTES = 5000;
const RECENT_SESSION_MAX_BYTES = 8000;
const QUERY_DEFAULT_LIMIT = 8;
const QUERY_MAX_LIMIT = 12;
const QUERY_MAX_RESPONSE_BYTES = 12000;
const GET_DEFAULT_MAX_LINES = 80;
const GET_MAX_LINES = 100;
const GET_DEFAULT_MAX_BYTES = 10000;
const GET_MAX_BYTES = 12000;
const MULTI_GET_DEFAULT_MAX_LINES = 60;
const MULTI_GET_MAX_LINES = 80;
const MULTI_GET_DEFAULT_MAX_BYTES = 16000;
const MULTI_GET_MAX_BYTES = 20000;
const bootstrapCache = new Map();
let transportStyle = "framed";

const MEMORY_MCP_INSTRUCTIONS = [
  "Use recent_session only for an explicit topicless last-conversation question such as what we were just discussing. If historical retrieval is needed and the prompt names a failure, decision, task, or subject, use query instead; a named current-state subject does not by itself require memory.",
  "Use query for historical recall with a concise intent and one to three typed searches: lex for a few discriminative exact terms or one exact phrase, vec for same-idea recall, and hyde only for nuanced concepts; then use get or multi_get for source evidence.",
  "For ordinary recall, make one query and one bounded get or multi_get, starting transcript retrieval near the hit's returned line instead of line 1. Stop when that source answers the question; do not search for redundant corroboration. Broaden once only when it does not answer. After broadening, batch multiple selected sources in one multi_get instead of serial get calls; follow one same-source continuation only when nextFromLine is needed to finish the decision.",
  "For a final-decision lookup, do not treat a source window ending in a proposal, question, or confirmation request as final; follow its nextFromLine continuation.",
  "Do not call memory when the current thread or current checkout already contains the needed evidence. For current Git landing, containment, or ref-existence questions, inspect current refs first; memory may resolve an approximate historical label but current Git remains authority for current state. Call this server sequentially.",
  "Treat tools/list as the canonical client surface; unadvertised compatibility aliases exist only for cached clients and are not peer tools to recommend.",
].join(" ");

const READ_ONLY_TOOL_ANNOTATIONS = {
  readOnlyHint: true,
  destructiveHint: false,
  idempotentHint: true,
  openWorldHint: false,
};

function bootstrapContract() {
  return {
    source: "codex-memory-mcp",
    allowed_reasons: ["repo_cwd_change", "prior_thread_recovery", "demonstrated_drift"],
    default_recent_sessions: 3,
    max_recent_sessions: 5,
    max_serialized_payload_bytes: BOOTSTRAP_MAX_BYTES,
    deduplication: { proven: true, scope: "same_mcp_process_per_project_reason_and_recent_session_limit", behavior: "returns a compact response without repeated structured context" },
    payload_bound: { proven: true, max_bytes: BOOTSTRAP_MAX_BYTES, measurement: "final structuredContent JSON UTF-8 bytes" },
    historical_retrieval_boundary: "Bootstrap is a durable re-anchor; use query then get or multi_get for historical wording and docs-vs-transcript evidence.",
  };
}

if (process.argv[2] === "--bootstrap-contract") {
  process.stdout.write(`${JSON.stringify(bootstrapContract())}\n`, () => process.exit(0));
}

function writeMessage(message) {
  if (transportStyle === "json") {
    process.stdout.write(`${JSON.stringify(message)}\n`);
    return;
  }
  const payload = Buffer.from(JSON.stringify(message), "utf8");
  const header = Buffer.from(`Content-Length: ${payload.length}\r\n\r\n`, "utf8");
  process.stdout.write(Buffer.concat([header, payload]));
}

function sendResponse(id, result) {
  writeMessage({ jsonrpc: "2.0", id, result });
}

function sendError(id, code, message, data) {
  const error = { code, message };
  if (data !== undefined) {
    error.data = data;
  }
  writeMessage({ jsonrpc: "2.0", id, error });
}

function runCommand(command, args, options = {}) {
  return spawnSync(command, args, {
    encoding: "utf8",
    env: process.env,
    ...options,
  });
}

function checkpointResolution(projectPath) {
  const result = runCommand(PROJECT_CHECKPOINT_BIN, ["doctor", "--repo", projectPath, "--json"]);
  const raw = result.status === 0 ? result.stdout : result.stderr;
  try {
    const parsed = JSON.parse(String(raw || "").trim());
    if (parsed?.reason === "git_repository_unavailable") {
      const tracked = readTextIfExists(path.join(projectPath, "CHECKPOINT.md")) || "";
      if (!/^kind: codex_project_checkpoint_stub$/m.test(tracked)) return { ok: true, adopted: false, state: "not_adopted" };
    }
    return parsed && typeof parsed === "object" ? parsed : { ok: false, state: "unreadable", reason: "resolver_output_invalid" };
  } catch {
    return { ok: false, state: "unreadable", reason: "resolver_unavailable" };
  }
}

function checkpointSignature(resolution) {
  return JSON.stringify({
    ok: resolution?.ok === true,
    adopted: resolution?.adopted === true,
    state: String(resolution?.state || "unreadable"),
    project_id: String(resolution?.project_id || ""),
    generation: Number.isInteger(resolution?.generation) ? resolution.generation : 0,
    reason: String(resolution?.reason || ""),
  });
}

function readJsonIfExists(file) {
  try {
    if (!fs.existsSync(file)) {
      return null;
    }
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return null;
  }
}

function readTextIfExists(file) {
  try {
    if (!fs.existsSync(file)) {
      return "";
    }
    return fs.readFileSync(file, "utf8").trim();
  } catch {
    return "";
  }
}

function normalizePath(inputPath) {
  try {
    if (!inputPath) {
      return process.cwd();
    }
    return fs.realpathSync(inputPath);
  } catch {
    return path.resolve(inputPath || process.cwd());
  }
}

function canonicalProjectPath(cwd) {
  const resolved = normalizePath(cwd);
  const common = runCommand("git", ["-C", resolved, "rev-parse", "--git-common-dir"]);
  if (common.status === 0 && common.stdout && common.stdout.trim().length > 0) {
    const rawCommon = common.stdout.trim();
    const commonPath = normalizePath(path.isAbsolute(rawCommon) ? rawCommon : path.resolve(resolved, rawCommon));
    if (path.basename(commonPath) === ".git") return path.dirname(commonPath);
  }
  const git = runCommand("git", ["-C", resolved, "rev-parse", "--show-toplevel"]);
  if (git.status === 0 && git.stdout && git.stdout.trim().length > 0) {
    return git.stdout.trim();
  }
  return resolved;
}

function projectKeyForPath(projectPath) {
  const base = path.basename(projectPath || "project")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+/, "")
    .replace(/-+$/, "") || "project";
  const hash = crypto.createHash("sha1").update(projectPath).digest("hex").slice(0, 12);
  return `${base}-${hash}`;
}

function readBootstrapForKey(projectKey) {
  if (!projectKey) {
    return null;
  }
  const bootstrapFile = path.join(PROJECTS_DIR, projectKey, "bootstrap.json");
  return readJsonIfExists(bootstrapFile);
}

function unixSecondsFromIso(value) {
  const t = Date.parse(value || "");
  if (!Number.isFinite(t)) {
    return 0;
  }
  return Math.floor(t / 1000);
}

function refreshSync(projectPath) {
  if (!fs.existsSync(SYNC_SCRIPT)) {
    return { ok: false, reason: `missing sync script: ${SYNC_SCRIPT}` };
  }
  const args = ["--state-only"];
  if (projectPath) {
    args.push("--project-path", projectPath);
  }
  const result = runCommand(SYNC_SCRIPT, args);
  if (result.status === 0) {
    return { ok: true };
  }
  const stderr = (result.stderr || "").trim();
  const stdout = (result.stdout || "").trim();
  const detail = stderr || stdout || `exit ${result.status}`;
  return { ok: false, reason: detail };
}

function lockOwnerPath() {
  return path.join(SYNC_LOCK_DIR, SYNC_LOCK_OWNER_FILE);
}

function processIsAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error && error.code === "EPERM";
  }
}

function lockAgeSeconds() {
  try {
    const stat = fs.statSync(SYNC_LOCK_DIR);
    return Math.max(0, Math.floor((Date.now() - stat.mtimeMs) / 1000));
  } catch {
    return 0;
  }
}

function clearStaleSyncLockIfNeeded() {
  if (!fs.existsSync(SYNC_LOCK_DIR)) {
    return false;
  }

  const owner = readJsonIfExists(lockOwnerPath());
  const ownerPid = owner && Number(owner.pid);
  const ownerHost = owner && typeof owner.host === "string" ? owner.host : "";
  const currentHost = os.hostname();

  if (Number.isInteger(ownerPid) && ownerPid > 0 && ownerHost && ownerHost === currentHost) {
    if (processIsAlive(ownerPid)) {
      return false;
    }
    try {
      fs.rmSync(lockOwnerPath(), { force: true });
      fs.rmdirSync(SYNC_LOCK_DIR);
      return true;
    } catch {
      return false;
    }
  }

  if (lockAgeSeconds() >= SYNC_LOCK_STALE_SECONDS) {
    try {
      fs.rmSync(lockOwnerPath(), { force: true });
      fs.rmdirSync(SYNC_LOCK_DIR);
      return true;
    } catch {
      return false;
    }
  }

  return false;
}

function backgroundRefreshRunning() {
  if (!fs.existsSync(SYNC_LOCK_DIR)) {
    return false;
  }
  clearStaleSyncLockIfNeeded();
  return fs.existsSync(SYNC_LOCK_DIR);
}

function startBackgroundRefresh(projectPath) {
  if (!fs.existsSync(SYNC_SCRIPT) || backgroundRefreshRunning()) {
    return;
  }

  const args = ["--state-only"];
  if (projectPath) {
    args.push("--project-path", projectPath);
  }

  try {
    const child = spawn(SYNC_SCRIPT, args, {
      detached: true,
      stdio: "ignore",
    });
    child.unref();
  } catch {
    // Keep stale bootstrap reads fast even if the background refresh launch fails.
  }
}

function runQmd(args, { expectJson = false } = {}) {
  const result = runCommand(QMD_CLI, args);
  if (result.status !== 0) {
    const detail = (result.stderr || result.stdout || `exit ${result.status}`).trim();
    throw new Error(detail || "qmd command failed");
  }
  const stdout = (result.stdout || "").trim();
  if (!expectJson) {
    return stdout;
  }
  if (!stdout) {
    return [];
  }
  return JSON.parse(stdout);
}

function readStatusText() {
  return runQmd(["status"]);
}

function statusDbPath(statusText) {
  const match = statusText.match(/^Index:\s+(.+)$/m);
  return match ? match[1].trim() : `${PROJECT_CACHE_ROOT}.sqlite`;
}

function statusCollectionName(statusText) {
  const match = statusText.match(/^\s{2}(.+?) \(qmd:\/\/.+\)$/m);
  return match ? match[1].trim() : "codex-chat";
}

function statusDocumentCount(statusText) {
  const match = statusText.match(/^\s*Total:\s+(\d+)/m);
  return match ? Number(match[1]) : 0;
}

function statusVectorCount(statusText) {
  const match = statusText.match(/^\s*Vectors:\s+(\d+)/m);
  return match ? Number(match[1]) : 0;
}

function statusContextCount(statusText) {
  const match = statusText.match(/^\s*Contexts:\s+(\d+)/m);
  return match ? Number(match[1]) : 0;
}

function normalizeCollectionFilter(collection) {
  const requested = String(collection || "").trim();
  if (!requested) {
    return "";
  }
  if (requested === DEFAULT_INDEX || requested === "codex-chat") {
    return statusCollectionName(readStatusText());
  }
  throw new Error("public memory queries are confined to the codex-chat collection");
}

function fileMtimeIso(file) {
  try {
    return fs.statSync(file).mtime.toISOString();
  } catch {
    return "";
  }
}

function sqliteScalar(dbPath, sql) {
  const result = runCommand(SQLITE3_BIN, [dbPath, sql]);
  if (result.status !== 0) {
    throw new Error((result.stderr || result.stdout || "sqlite query failed").trim());
  }
  return (result.stdout || "").trim();
}

function buildStatus() {
  const statusText = readStatusText();
  const dbPath = statusDbPath(statusText);
  const totalDocuments = statusDocumentCount(statusText);
  const vectorCount = statusVectorCount(statusText);
  const contextCount = statusContextCount(statusText);
  const collectionName = statusCollectionName(statusText);
  const needsEmbeddingText = sqliteScalar(
    dbPath,
    "select count(distinct d.hash) from documents d where d.active = 1 and d.hash not in (select hash from content_vectors);",
  );
  const needsEmbedding = Number(needsEmbeddingText || "0");
  return {
    totalDocuments,
    needsEmbedding,
    hasVectorIndex: vectorCount > 0,
    collections: [
      {
        name: collectionName,
        path: PROJECT_CACHE_ROOT,
        pattern: "**/*.md",
        documents: totalDocuments,
        lastUpdated: fileMtimeIso(dbPath),
        contexts: contextCount,
      },
    ],
  };
}

function buildSearchArgs(commandName, args) {
  const query = String(args.query || "").trim();
  if (!query) {
    throw new Error("query is required");
  }
  const unsupportedFilterMatch = query.match(/(?:^|\s)(project|repo|path|cwd):\S+/i);
  if (unsupportedFilterMatch) {
    throw new Error(
      `query must be plain search text, not unsupported \`${unsupportedFilterMatch[1].toLowerCase()}:\` filter syntax; re-anchor with bootstrap_context when needed and search with plain terms`,
    );
  }

  const cliArgs = [commandName, query];
  if (Number.isInteger(args.limit)) {
    cliArgs.push("-n", String(args.limit));
  }
  if (typeof args.minScore === "number") {
    cliArgs.push("--min-score", String(args.minScore));
  }
  if (typeof args.intent === "string" && args.intent.trim().length > 0) {
    cliArgs.push("--intent", args.intent.trim());
  }
  const collections = Array.isArray(args.collections)
    ? args.collections
    : (typeof args.collection === "string" && args.collection.length > 0 ? [args.collection] : []);
  for (const rawCollection of collections) {
    const collection = normalizeCollectionFilter(rawCollection);
    if (collection) cliArgs.push("-c", collection);
  }
  if (commandName === "query" && args.rerank === false) cliArgs.push("--no-rerank");
  cliArgs.push("--json");
  return cliArgs;
}

function sessionMetadataForUri(uri) {
  uri = normalizeReturnedQmdUri(uri);
  if (!isPublicQmdUri(uri) || !fs.existsSync(PROJECTS_DIR)) return null;
  for (const { index } of loadProjectIndexes()) {
    for (const session of index?.sessions || []) {
      if (`qmd://codex-chat/${session.projection_rel || ""}` === uri) return session;
    }
  }
  return null;
}

function loadProjectIndexes(projectRoot = "") {
  if (!fs.existsSync(PROJECTS_DIR)) return [];
  const normalizedProjectRoot = projectRoot ? canonicalProjectPath(projectRoot) : "";
  const entries = normalizedProjectRoot ? [projectKeyForPath(normalizedProjectRoot)] : fs.readdirSync(PROJECTS_DIR).sort();
  const indexes = [];
  for (const entry of entries) {
    const index = readJsonIfExists(path.join(PROJECTS_DIR, entry, "session_index.json"));
    if (!index || (normalizedProjectRoot && index.project_path !== normalizedProjectRoot)) continue;
    indexes.push({ entry, index });
  }
  return indexes;
}

function sessionCatalog(projectRoot = "") {
  projectRoot = projectRoot ? canonicalProjectPath(projectRoot) : "";
  const sessions = [];
  const sessionEntries = [];
  for (const { entry, index } of loadProjectIndexes(projectRoot)) {
    for (const session of index.sessions || []) {
      if (!projectRoot || session.project_path === projectRoot) {
        sessions.push(session);
        sessionEntries.push({ session, project_key: String(index.project_key || entry) });
      }
    }
  }
  const children = new Map();
  for (const session of sessions) {
    if (!session.parent_thread_id || !session.session_id) continue;
    const entries = children.get(session.parent_thread_id) || [];
    entries.push(session.session_id);
    children.set(session.parent_thread_id, entries);
  }
  return { sessions, children, sessionEntries };
}

function descendantThreadIds(threadId, projectRoot = "", catalog = null) {
  const { children } = catalog || sessionCatalog(projectRoot);
  const seen = new Set();
  const queue = [threadId];
  while (queue.length > 0) {
    const current = queue.shift();
    if (!current || seen.has(current)) continue;
    seen.add(current);
    for (const child of children.get(current) || []) if (!seen.has(child)) queue.push(child);
  }
  return seen;
}

function isUtilitySession(session) {
  return ["awaiter_utility", "approval_review_utility", "unknown_utility"].includes(session?.session_kind);
}

function plausibleSessionId(value) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(value || "").trim());
}

function isReliablyDelegatedSession(session) {
  if (session?.session_kind === "subagent") return true;
  const parentThreadId = String(session?.parent_thread_id || "").trim();
  if (!parentThreadId) return false;
  if (["session_meta", "thread_spawn"].includes(session?.lineage_source)) return true;
  if (session?.lineage_source === "delegation_tag") return plausibleSessionId(parentThreadId);
  return session?.delegated === true && plausibleSessionId(parentThreadId);
}

function sessionProjectionPath(session) {
  const relative = typeof session?.projection_rel === "string" ? session.projection_rel.trim() : "";
  if (!relative || path.isAbsolute(relative) || relative.split(path.sep).includes("..")) return "";
  const root = path.resolve(PROJECT_CACHE_ROOT);
  const candidate = path.resolve(root, relative);
  if (candidate !== root && !candidate.startsWith(`${root}${path.sep}`)) return "";
  return fs.existsSync(candidate) ? candidate : "";
}

function sessionSourcePath(session) {
  const relative = typeof session?.source_rel === "string" ? session.source_rel.trim() : "";
  if (!relative || path.isAbsolute(relative) || relative.split(path.sep).includes("..")) return "";
  const root = path.resolve(HOME, ".codex", "sessions");
  const candidate = path.resolve(root, relative);
  if (candidate !== root && !candidate.startsWith(`${root}${path.sep}`)) return "";
  return fs.existsSync(candidate) ? candidate : "";
}

function lastJsonTimestamp(file) {
  try {
    if (!file || !fs.existsSync(file)) return "";
    const stat = fs.statSync(file);
    const readBytes = Math.min(stat.size, RAW_SESSION_MAX_LINE_BYTES);
    const fd = fs.openSync(file, "r");
    const buffer = Buffer.alloc(readBytes);
    try {
      fs.readSync(fd, buffer, 0, readBytes, Math.max(0, stat.size - readBytes));
    } finally {
      fs.closeSync(fd);
    }
    for (const line of buffer.toString("utf8").split(/\r?\n/).reverse()) {
      const candidate = line.trim();
      if (!candidate.startsWith("{")) continue;
      try {
        const parsed = JSON.parse(candidate);
        const timestamp = String(parsed?.timestamp || parsed?.payload?.timestamp || "").trim();
        if (Number.isFinite(Date.parse(timestamp))) return timestamp;
      } catch {
        // Continue through a possibly partial tail buffer.
      }
    }
  } catch {
    return "";
  }
  return "";
}

function sessionActivityRankUtc(session) {
  const sourcePath = sessionSourcePath(session);
  try {
    if (sourcePath) return fs.statSync(sourcePath).mtime.toISOString();
  } catch {
    // Fall through to the projected transcript.
  }
  const projectionPath = sessionProjectionPath(session);
  try {
    if (projectionPath) return fs.statSync(projectionPath).mtime.toISOString();
  } catch {
    // Fall through to the stable session start timestamp.
  }
  return String(session?.started_utc || "");
}

function projectedConversationMessages(text) {
  const source = String(text || "");
  const matches = Array.from(source.matchAll(/^## (USER|ASSISTANT)\s*$/gm));
  return matches.map((match, index) => ({
    role: match[1].toLowerCase(),
    text: source.slice(match.index + match[0].length, index + 1 < matches.length ? matches[index + 1].index : source.length).trim(),
  })).filter((message) => message.text);
}

function boundRecentSession(result, maxBytes) {
  const byteLength = () => Buffer.byteLength(JSON.stringify(result), "utf8");
  while (result.messages.length > 2 && byteLength() > maxBytes) result.messages.shift();
  if (byteLength() <= maxBytes) return result;
  const available = Math.max(128, maxBytes - Buffer.byteLength(JSON.stringify({ ...result, messages: [] }), "utf8") - 128);
  const perMessage = Math.max(64, Math.floor(available / Math.max(1, result.messages.length)));
  result.messages = result.messages.map((message) => ({ role: message.role, text: limitUtf8Text(message.text, perMessage) }));
  while (result.messages.length > 1 && byteLength() > maxBytes) result.messages.shift();
  if (byteLength() > maxBytes && result.messages.length === 1) {
    const overhead = Buffer.byteLength(JSON.stringify({ ...result, messages: [{ role: result.messages[0].role, text: "" }] }), "utf8");
    result.messages[0].text = limitUtf8Text(result.messages[0].text, Math.max(0, maxBytes - overhead));
  }
  if (byteLength() > maxBytes) throw new Error(`recent_session structured payload exceeds ${maxBytes} bytes after bounding`);
  return result;
}

function recentSession(args) {
  const projectRootInput = String(args.project_root || "").trim();
  const projectRoot = projectRootInput ? canonicalProjectPath(projectRootInput) : "";
  const excludeThreadId = String(args.exclude_thread_id || "").trim();
  if (args.max_messages !== undefined && (!Number.isInteger(args.max_messages) || args.max_messages < 1)) throw new Error("max_messages must be a positive integer");
  if (args.max_bytes !== undefined && (!Number.isInteger(args.max_bytes) || args.max_bytes < 512)) throw new Error("max_bytes must be an integer of at least 512");
  const maxMessages = Math.min(args.max_messages ?? RECENT_SESSION_DEFAULT_MAX_MESSAGES, RECENT_SESSION_MAX_MESSAGES);
  const maxBytes = Math.min(args.max_bytes ?? RECENT_SESSION_DEFAULT_MAX_BYTES, RECENT_SESSION_MAX_BYTES);
  const catalog = sessionCatalog(projectRoot);
  const eligible = catalog.sessionEntries
    .filter(({ session }) => session?.projected === true && typeof session?.projection_rel === "string" && session.projection_rel.trim())
    .filter(({ session }) => !session.suppressed && !isUtilitySession(session) && !isReliablyDelegatedSession(session))
    .filter(({ session }) => !excludeThreadId || session.session_id !== excludeThreadId)
    .map((entry) => ({ ...entry, activity_rank_utc: sessionActivityRankUtc(entry.session) }))
    .sort((left, right) => String(right.activity_rank_utc || "").localeCompare(String(left.activity_rank_utc || "")) || String(right.session.started_utc || "").localeCompare(String(left.session.started_utc || "")));
  if (eligible.length === 0) throw new Error(projectRoot ? `no eligible projected sessions for ${projectRoot}` : "no eligible projected sessions");
  const selected = eligible[0];
  const projectionPath = sessionProjectionPath(selected.session);
  if (!projectionPath) throw new Error("newest eligible session projection is unavailable");
  const messages = projectedConversationMessages(fs.readFileSync(projectionPath, "utf8")).slice(-maxMessages);
  if (messages.length === 0) throw new Error("newest eligible session contains no projected conversation messages");
  return boundRecentSession({
    session_id: String(selected.session.session_id || ""),
    started_utc: String(selected.session.started_utc || ""),
    last_activity_utc: lastJsonTimestamp(sessionSourcePath(selected.session)) || selected.activity_rank_utc || String(selected.session.started_utc || ""),
    project_key: String(selected.project_key || ""),
    uri: publicQmdUriForRelativePath(selected.session.projection_rel),
    messages,
  }, maxBytes);
}

function filterSearchResults(results, args) {
  const hasFilter = ["date_from", "date_to", "cwd", "project_root", "thread_id", "parent_thread_id", "own_thread_id"].some((key) => typeof args[key] === "string" && args[key].trim());
  if (!hasFilter) return results;
  const projectRoot = args.project_root ? canonicalProjectPath(args.project_root) : "";
  const ownedIds = args.own_thread_id ? descendantThreadIds(args.own_thread_id, args.project_root || "") : null;
  return results.filter((item) => {
    const meta = sessionMetadataForUri(item?.file || "");
    if (!meta) return false;
    const started = String(meta.started_utc || "").slice(0, 10);
    if (args.date_from && started < args.date_from) return false;
    if (args.date_to && started > args.date_to) return false;
    if (args.cwd && meta.cwd !== args.cwd) return false;
    if (projectRoot && meta.project_path !== projectRoot) return false;
    if (args.thread_id && meta.session_id !== args.thread_id) return false;
    if (args.parent_thread_id && meta.parent_thread_id !== args.parent_thread_id) return false;
    if (ownedIds && !ownedIds.has(meta.session_id)) return false;
    return true;
  });
}

function callSearch(commandName, args) {
  for (const key of ["date_from", "date_to"]) if (args[key] && (!/^\d{4}-\d{2}-\d{2}$/.test(args[key]) || Number.isNaN(Date.parse(`${args[key]}T00:00:00Z`)) || new Date(`${args[key]}T00:00:00Z`).toISOString().slice(0, 10) !== args[key])) throw new Error(`${key} must be a real YYYY-MM-DD date`);
  if (args.limit !== undefined && (!Number.isInteger(args.limit) || args.limit <= 0)) throw new Error("limit must be a positive integer");
  const filtered = ["date_from", "date_to", "cwd", "project_root", "thread_id", "parent_thread_id", "own_thread_id"].some((key) => args[key]);
  const requested = Math.min(args.limit ?? QUERY_DEFAULT_LIMIT, QUERY_MAX_LIMIT);
  const engineArgs = filtered ? { ...args, limit: Math.max(requested, 100) } : { ...args, limit: requested };
  const results = filterSearchResults(runQmd(buildSearchArgs(commandName, engineArgs), { expectJson: true }), args);
  return { results: boundSearchResults(results.slice(0, requested), QUERY_MAX_RESPONSE_BYTES) };
}

function compactSearchValue(value, key = "") {
  if (typeof value === "string") return ["file", "docid"].includes(key) ? value : limitUtf8Text(value, 2048);
  if (Array.isArray(value)) return value.slice(0, 8).map((item) => compactSearchValue(item));
  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([childKey, childValue]) => [childKey, compactSearchValue(childValue, childKey)]));
  return value;
}

function boundSearchResults(results, maxBytes) {
  const bounded = [];
  for (const result of results) {
    const candidate = compactSearchValue(result);
    if (Buffer.byteLength(JSON.stringify([...bounded, candidate]), "utf8") > maxBytes) break;
    bounded.push(candidate);
  }
  return bounded;
}

function callUnifiedQuery(args) {
  const intent = String(args.intent || "").trim();
  const searches = Array.isArray(args.searches) ? args.searches : [];
  if (!intent) throw new Error("intent is required");
  if (searches.length < 1 || searches.length > 3) throw new Error("searches must contain from 1 to 3 typed searches");
  const normalized = [];
  for (const search of searches) {
    const type = String(search?.type || "").trim();
    const query = String(search?.query || "").trim();
    if (!["lex", "vec", "hyde"].includes(type) || !query || query.includes("\n")) throw new Error("each typed search requires type lex, vec, or hyde and a single-line query");
    normalized.push({ type, query });
  }
  if (normalized.length === 1 && args.rerank === false && normalized[0].type === "lex") return callSearch("search", { ...args, query: normalized[0].query, searches: undefined, intent: undefined, rerank: undefined });
  if (normalized.length === 1 && args.rerank === false && normalized[0].type === "vec") return callSearch("vsearch", { ...args, query: normalized[0].query, searches: undefined, intent: undefined, rerank: undefined });
  const lines = [`intent: ${intent}`, ...normalized.map((search) => `${search.type}: ${search.query}`)];
  return callSearch("query", { ...args, query: lines.join("\n"), searches: undefined, intent: undefined });
}

function isPublicQmdUri(value) {
  return String(value || "").startsWith("qmd://codex-chat/");
}

function normalizeReturnedQmdUri(value) {
  const raw = String(value || "").trim();
  if (!isPublicQmdUri(raw)) return raw;
  const normalized = raw.split("?", 1)[0];
  if (!/^qmd:\/\/codex-chat\/.+/.test(normalized)) throw new Error("returned qmd URI has no safe document path");
  return normalized;
}

function isQmdDocId(value) {
  return /^#[^\s,]+$/.test(String(value || "").trim());
}

function hasGlobMagic(value) {
  return /[*?[]/.test(String(value || ""));
}

function publicQmdUriForRelativePath(value) {
  const trimmed = String(value || "").trim().replace(/^\/+/, "");
  if (!trimmed || isPublicQmdUri(trimmed)) {
    return trimmed;
  }
  return `qmd://codex-chat/${trimmed}`;
}

function requirePublicQmdUri(file) {
  if (!isPublicQmdUri(file)) {
    throw new Error("file must be a qmd://codex-chat/... document from the public memory surface");
  }
  return file;
}

function requirePublicQmdGetTarget(file) {
  const target = normalizeReturnedQmdUri(file);
  if (isPublicQmdUri(target) || isQmdDocId(target)) {
    return target;
  }
  throw new Error("file must be a qmd://codex-chat/... document, qmd://codex-chat/projects/<project_key> alias, or returned docid from the public memory surface");
}

function normalizePublicQmdBatchPattern(pattern) {
  const trimmed = String(pattern || "").trim();
  if (isPublicQmdUri(trimmed) || isQmdDocId(trimmed)) {
    return normalizeReturnedQmdUri(trimmed);
  }
  const parts = trimmed.split(",").map((part) => part.trim()).filter(Boolean);
  if (parts.length > 1 && parts.every((part) => isPublicQmdUri(part) || isQmdDocId(part))) {
    return parts.map(normalizeReturnedQmdUri).join(",");
  }
  return "";
}

function requirePublicQmdPattern(pattern) {
  const normalized = normalizePublicQmdBatchPattern(pattern);
  if (!normalized) {
    throw new Error("pattern must target qmd://codex-chat/... documents or returned docids from the public memory surface");
  }
  return normalized;
}

function projectMemoryPathForKey(projectKey) {
  return path.join(PROJECT_CACHE_ROOT, "projects", projectKey, "project-memory.md");
}

function projectMemoryKeyFromUri(file) {
  const uri = String(file || "").trim();
  if (!isPublicQmdUri(uri)) {
    return "";
  }
  const projectMatch = uri.match(/^qmd:\/\/codex-chat\/projects\/([^/]+)(?:\/project-memory\.md)?$/);
  if (projectMatch) {
    return projectMatch[1];
  }
  return "";
}

function projectMemoryKeyFromPattern(pattern) {
  const uriPattern = String(pattern || "").trim();
  if (!isPublicQmdUri(uriPattern)) {
    return "";
  }
  if (/^qmd:\/\/codex-chat\/projects\/\*/.test(uriPattern)) {
    throw new Error("pattern must not enumerate all project-memory docs; use an explicit qmd://codex-chat/projects/<project_key> target");
  }
  const projectMatch = uriPattern.match(/^qmd:\/\/codex-chat\/projects\/([^/*]+)(?:\/project-memory\.md)?$/);
  if (projectMatch) {
    return projectMatch[1];
  }
  return "";
}

function exactMemoryTargetsFromPattern(pattern) {
  const normalized = normalizePublicQmdBatchPattern(pattern);
  if (!normalized) {
    return [];
  }
  const parts = normalized.split(",").map((part) => part.trim()).filter(Boolean);
  if (parts.length === 0 || parts.some((part) => hasGlobMagic(part))) {
    return [];
  }
  return parts;
}

function limitUtf8Text(text, maxBytes) {
  if (!Number.isInteger(maxBytes) || maxBytes < 0) {
    return text;
  }
  let output = "";
  for (const char of String(text || "")) {
    const next = output + char;
    if (Buffer.byteLength(next, "utf8") > maxBytes) {
      break;
    }
    output = next;
  }
  return output;
}

function renderProjectMemory(projectKey, options = {}) {
  const filePath = projectMemoryPathForKey(projectKey);
  if (!fs.existsSync(filePath)) {
    throw new Error(`project memory missing: qmd://codex-chat/projects/${projectKey}`);
  }

  const fromLine = Number.isInteger(options.fromLine) ? Math.max(1, options.fromLine) : 1;
  const maxLines = Number.isInteger(options.maxLines) ? Math.max(0, options.maxLines) : null;
  const rawLines = fs.readFileSync(filePath, "utf8").split(/\r?\n/);
  const startIndex = Math.max(0, fromLine - 1);
  const selected = maxLines === null ? rawLines.slice(startIndex) : rawLines.slice(startIndex, startIndex + maxLines);
  const renderedLines = options.lineNumbers === true
    ? selected.map((line, index) => `${fromLine + index}: ${line}`)
    : selected;
  return limitUtf8Text(renderedLines.join("\n"), options.maxBytes);
}

function retrievalWindow(requestedArgs, boundedArgs, text = "") {
  const fromLine = Number.isInteger(boundedArgs.fromLine) ? boundedArgs.fromLine : 1;
  const lineClamped = Number.isInteger(requestedArgs.maxLines) && requestedArgs.maxLines > boundedArgs.maxLines;
  const byteClamped = Number.isInteger(requestedArgs.maxBytes) && requestedArgs.maxBytes > boundedArgs.maxBytes;
  const window = {
    fromLine,
    maxLines: boundedArgs.maxLines,
    maxBytes: boundedArgs.maxBytes,
    requestClamped: lineClamped || byteClamped,
  };
  const numberedLines = [...String(text).matchAll(/^(\d+):/gm)].map((match) => Number(match[1]));
  if (boundedArgs.lineNumbers === true && numberedLines.length >= boundedArgs.maxLines) {
    window.nextFromLine = numberedLines[numberedLines.length - 1] + 1;
  } else if (lineClamped) {
    window.nextFromLine = fromLine + boundedArgs.maxLines;
  }
  return window;
}

function callGet(args) {
  const requestedArgs = { ...args };
  const file = String(args.file || "").trim();
  if (!file) {
    throw new Error("file is required");
  }
  if (args.maxLines !== undefined && (!Number.isInteger(args.maxLines) || args.maxLines < 1)) throw new Error("maxLines must be a positive integer");
  if (args.maxBytes !== undefined && (!Number.isInteger(args.maxBytes) || args.maxBytes < 1024)) throw new Error("maxBytes must be an integer of at least 1024");
  args = { ...args, maxLines: Math.min(args.maxLines ?? GET_DEFAULT_MAX_LINES, GET_MAX_LINES), maxBytes: Math.min(args.maxBytes ?? GET_DEFAULT_MAX_BYTES, GET_MAX_BYTES) };

  const projectKey = projectMemoryKeyFromUri(file);
  if (projectKey) {
    const text = renderProjectMemory(projectKey, {
      fromLine: args.fromLine,
      maxLines: args.maxLines,
      maxBytes: args.maxBytes,
      lineNumbers: args.lineNumbers === true,
    });
    return {
      file,
      text,
      window: retrievalWindow(requestedArgs, args, text),
    };
  }

  const qmdTarget = requirePublicQmdGetTarget(file);
  const cliArgs = ["get", qmdTarget];
  if (Number.isInteger(args.fromLine)) {
    cliArgs.push("--from", String(args.fromLine));
  }
  cliArgs.push("-l", String(args.maxLines));
  if (args.lineNumbers === true) {
    cliArgs.push("--line-numbers");
  }
  const text = limitUtf8Text(runQmd(cliArgs), args.maxBytes);
  return { file, text, window: retrievalWindow(requestedArgs, args, text) };
}

function renderExplicitMemoryTarget(target, args) {
  const projectKey = projectMemoryKeyFromUri(target);
  if (projectKey) {
    return renderProjectMemory(projectKey, {
      maxLines: args.maxLines,
      maxBytes: args.maxBytes,
      lineNumbers: args.lineNumbers === true,
    });
  }

  const qmdTarget = requirePublicQmdGetTarget(target);
  const cliArgs = ["get", qmdTarget];
  if (Number.isInteger(args.maxLines)) {
    cliArgs.push("-l", String(args.maxLines));
  }
  if (args.lineNumbers === true) {
    cliArgs.push("--line-numbers");
  }
  return limitUtf8Text(runQmd(cliArgs), args.maxBytes);
}

function callMultiGet(args) {
  const pattern = String(args.pattern || "").trim();
  if (!pattern) {
    throw new Error("pattern is required");
  }
  if (args.maxLines !== undefined && (!Number.isInteger(args.maxLines) || args.maxLines < 1)) throw new Error("maxLines must be a positive integer");
  if (args.maxBytes !== undefined && (!Number.isInteger(args.maxBytes) || args.maxBytes < 1024)) throw new Error("maxBytes must be an integer of at least 1024");
  args = { ...args, maxLines: Math.min(args.maxLines ?? MULTI_GET_DEFAULT_MAX_LINES, MULTI_GET_MAX_LINES), maxBytes: Math.min(args.maxBytes ?? MULTI_GET_DEFAULT_MAX_BYTES, MULTI_GET_MAX_BYTES) };

  const projectKey = projectMemoryKeyFromPattern(pattern);
  if (projectKey) {
    return {
      pattern,
      text: renderProjectMemory(projectKey, {
        maxLines: args.maxLines,
        maxBytes: args.maxBytes,
        lineNumbers: args.lineNumbers === true,
      }),
    };
  }

  const exactTargets = exactMemoryTargetsFromPattern(pattern);
  if (exactTargets.length > 0) {
    const chunks = exactTargets.map((target) => renderExplicitMemoryTarget(target, args)).filter((text) => text.length > 0);
    return {
      pattern,
      text: limitUtf8Text(chunks.join("\n\n---\n\n"), args.maxBytes),
    };
  }

  const qmdPattern = requirePublicQmdPattern(pattern);
  const cliArgs = ["multi-get", qmdPattern];
  if (Number.isInteger(args.maxLines)) {
    cliArgs.push("-l", String(args.maxLines));
  }
  if (Number.isInteger(args.maxBytes)) {
    cliArgs.push("--max-bytes", String(args.maxBytes));
  }
  if (args.lineNumbers === true) {
    cliArgs.push("--line-numbers");
  }
  return { pattern, text: limitUtf8Text(runQmd(cliArgs), args.maxBytes) };
}

function buildColdStart(projectPath, projectKey, checkpointResolver = {}) {
  const lastSync = new Date(0).toISOString();
  const projectFrame = "Use the current working directory and its durable local docs as the continuity anchor.";
  const summary = [
    `Project: ${projectPath}`,
    `Project frame: ${projectFrame}`,
    "",
    "Durable constraints:",
    "- (none)",
    "",
    "Historical open loops:",
    "- (none)",
    "",
    "Recent sessions:",
    "- (none)",
  ].join("\n");
  return {
    project_key: projectKey,
    project_path: projectPath,
    last_sync_utc: lastSync,
    project_frame: projectFrame,
    summary,
    intent_pins: [],
    open_loops: [],
    recent_sessions: [],
    evidence_paths: [],
    checkpoint_resolver: checkpointResolver,
  };
}

function coerceRecentSessions(list, maxCount) {
  if (!Array.isArray(list)) {
    return [];
  }
  return list
    .filter((item) => item && typeof item.path === "string")
    .slice(0, maxCount)
    .map((item) => ({
      path: publicQmdUriForRelativePath(item.path),
      started_utc: typeof item.started_utc === "string" ? item.started_utc : "",
    }))
    .filter((item) => isPublicQmdUri(item.path));
}

function coerceEvidencePaths(list) {
  if (!Array.isArray(list)) {
    return [];
  }
  return list
    .map((item) => publicQmdUriForRelativePath(item))
    .filter((item) => isPublicQmdUri(item))
    .slice(0, 20);
}

function buildSummaryFromBootstrap(bootstrap, maxRecent) {
  const result = {
    project_key: String(bootstrap.project_key || ""),
    project_path: String(bootstrap.project_path || ""),
    last_sync_utc: String(bootstrap.last_sync_utc || ""),
    project_frame: String(bootstrap.project_frame || ""),
    summary: String(bootstrap.summary || ""),
    intent_pins: Array.isArray(bootstrap.intent_pins) ? bootstrap.intent_pins.slice(0, 20) : [],
    open_loops: Array.isArray(bootstrap.open_loops) ? bootstrap.open_loops.slice(0, 20) : [],
    recent_sessions: coerceRecentSessions(bootstrap.recent_sessions, maxRecent),
    evidence_paths: coerceEvidencePaths(bootstrap.evidence_paths),
    checkpoint_resolver: bootstrap.checkpoint_resolver && typeof bootstrap.checkpoint_resolver === "object"
      ? bootstrap.checkpoint_resolver
      : {},
  };

  if (!result.summary) {
    const lines = [];
    lines.push(`Project: ${result.project_path || "(unknown)"}`);
    lines.push(
      `Project frame: ${result.project_frame || "Use the current working directory and its durable local docs as the continuity anchor."}`,
    );
    lines.push("");
    lines.push("Durable constraints:");
    if (result.intent_pins.length === 0) {
      lines.push("- (none)");
    } else {
      for (const pin of result.intent_pins.slice(0, 8)) {
        lines.push(`- ${pin}`);
      }
    }
    lines.push("");
    lines.push("Historical open loops:");
    if (result.open_loops.length === 0) {
      lines.push("- (none)");
    } else {
      for (const loop of result.open_loops.slice(0, 8)) {
        lines.push(`- ${loop}`);
      }
    }
    lines.push("");
    lines.push("Recent sessions:");
    if (result.recent_sessions.length === 0) {
      lines.push("- (none)");
    } else {
      for (const session of result.recent_sessions) {
        lines.push(`- ${session.started_utc || "unknown"} ${session.path}`);
      }
    }
    result.summary = lines.join("\n");
  }

  return result;
}

function appendBootstrapEvent(event) {
  try {
    fs.mkdirSync(path.dirname(BOOTSTRAP_EVENTS_FILE), { recursive: true });
    fs.appendFileSync(BOOTSTRAP_EVENTS_FILE, `${JSON.stringify(event)}\n`, "utf8");
  } catch {
    // Telemetry must never turn a read-only bootstrap into a failed startup.
  }
}

function bootstrapReason(args) {
  const reason = typeof args.reason === "string" ? args.reason.trim() : "";
  const allowed = new Set(["repo_cwd_change", "prior_thread_recovery", "demonstrated_drift"]);
  if (!allowed.has(reason)) throw new Error("reason must be repo_cwd_change, prior_thread_recovery, or demonstrated_drift; use query then get/multi_get for historical wording");
  return reason;
}

function boundBootstrap(result) {
  for (const key of ["project_frame", "summary"]) if (Object.hasOwn(result, key)) result[key] = limitUtf8Text(String(result[key] || ""), 2000);
  for (const key of ["intent_pins", "open_loops", "evidence_paths"]) if (Object.hasOwn(result, key)) result[key] = (Array.isArray(result[key]) ? result[key] : []).slice(0, 4).map((value) => limitUtf8Text(String(value), 240));
  if (Object.hasOwn(result, "recent_sessions")) result.recent_sessions = (Array.isArray(result.recent_sessions) ? result.recent_sessions : []).slice(0, 3).map((item) => ({ path: limitUtf8Text(String(item.path || ""), 240), started_utc: String(item.started_utc || "").slice(0, 32) }));
  let payload = Buffer.byteLength(JSON.stringify(result), "utf8");
  for (const key of ["intent_pins", "open_loops", "evidence_paths", "recent_sessions"]) {
    while (payload > BOOTSTRAP_MAX_BYTES && Array.isArray(result[key]) && result[key].length) {
      result[key].pop();
      payload = Buffer.byteLength(JSON.stringify(result), "utf8");
    }
  }
  for (const key of ["summary", "project_frame"]) {
    while (payload > BOOTSTRAP_MAX_BYTES && typeof result[key] === "string" && Buffer.byteLength(result[key], "utf8") > 128) {
      result[key] = limitUtf8Text(result[key], Math.max(128, Math.floor(Buffer.byteLength(result[key], "utf8") * 0.75)));
      payload = Buffer.byteLength(JSON.stringify(result), "utf8");
    }
  }
  if (payload > BOOTSTRAP_MAX_BYTES) throw new Error(`bootstrap structured payload exceeds ${BOOTSTRAP_MAX_BYTES} bytes after bounding`);
  return payload;
}

function finalizeBootstrap(result, telemetry) {
  result.telemetry = { ...telemetry, payload_bytes: 0 };
  for (let attempt = 0; attempt < 6; attempt += 1) {
    boundBootstrap(result);
    const payloadBytes = Buffer.byteLength(JSON.stringify(result), "utf8");
    if (result.telemetry.payload_bytes === payloadBytes) return payloadBytes;
    result.telemetry.payload_bytes = payloadBytes;
  }
  const payloadBytes = boundBootstrap(result);
  result.telemetry.payload_bytes = payloadBytes;
  const finalBytes = Buffer.byteLength(JSON.stringify(result), "utf8");
  if (finalBytes > BOOTSTRAP_MAX_BYTES) throw new Error(`bootstrap structured payload exceeds ${BOOTSTRAP_MAX_BYTES} bytes after telemetry`);
  result.telemetry.payload_bytes = finalBytes;
  return finalBytes;
}

function latestBootstrapResource() {
  const latestProjectKey = readTextIfExists(LATEST_PROJECT_KEY_FILE);
  const bootstrap = readBootstrapForKey(latestProjectKey);
  if (bootstrap) {
    return buildSummaryFromBootstrap(bootstrap, 3);
  }
  const projectPath = process.cwd();
  return buildColdStart(projectPath, projectKeyForPath(projectPath));
}

function resourceListResult() {
  return { resources: [] };
}

function readResource(params) {
  const uri = String(params?.uri || "").trim();
  if (!uri) {
    throw new Error("uri is required");
  }

  if (uri === "bootstrap_context" || uri.startsWith("memory://bootstrap") || (uri.startsWith("memory://projects/") && uri.endsWith("/bootstrap"))) throw new Error(`bootstrap startup context is tool-only; ${uri} is not a readable resource. Use tools/call with name bootstrap_context and an explicit reason.`);

  if (uri.startsWith("qmd://")) {
    return {
      contents: [
        {
          uri,
          mimeType: "text/markdown",
          text: runQmd(["get", uri]),
        },
      ],
    };
  }

  throw new Error(`unknown resource: ${uri}`);
}

function bootstrapContext(args) {
  const cwd = typeof args.cwd === "string" && args.cwd.length > 0 ? args.cwd : process.cwd();
  const refreshIfStale = args.refresh_if_stale !== false;
  const maxRecent = Number.isInteger(args.max_recent_sessions)
    ? Math.max(1, Math.min(5, args.max_recent_sessions))
    : 3;

  const projectPath = canonicalProjectPath(cwd);
  const inferredProjectKey = projectKeyForPath(projectPath);
  const reason = bootstrapReason(args);
  const currentCheckpoint = checkpointResolution(projectPath);
  const currentCheckpointSignature = checkpointSignature(currentCheckpoint);
  const cacheKey = `${inferredProjectKey}:${reason}:${maxRecent}:${currentCheckpointSignature}`;
  const cached = bootstrapCache.get(cacheKey);
  if (cached && Date.now() - cached.at < STALE_SECONDS * 1000) {
    const summary = `Bootstrap already supplied for ${inferredProjectKey}; use query then get/multi_get for history.`;
    const result = { project_key: inferredProjectKey, summary };
    const payloadBytes = finalizeBootstrap(result, { reason, source: "process_cache", summary_bytes: Buffer.byteLength(summary, "utf8"), source_payload_bytes: cached.result.telemetry.payload_bytes, max_bytes: BOOTSTRAP_MAX_BYTES, max_recent_sessions: maxRecent, deduplicated: true });
    appendBootstrapEvent({ at: new Date().toISOString(), event: "bootstrap", project_key: inferredProjectKey, reason, source: "process_cache", payload_bytes: payloadBytes, deduplicated: true });
    return result;
  }

  const exactBootstrap = readBootstrapForKey(inferredProjectKey);
  const lastSyncSeconds = unixSecondsFromIso(exactBootstrap?.last_sync_utc || "");
  const nowSeconds = Math.floor(Date.now() / 1000);
  const resolverChanged = exactBootstrap
    ? checkpointSignature(exactBootstrap.checkpoint_resolver || {}) !== currentCheckpointSignature
    : false;
  const isStale = exactBootstrap ? resolverChanged || nowSeconds - lastSyncSeconds > STALE_SECONDS : true;

  if (refreshIfStale && isStale) {
    startBackgroundRefresh(projectPath);
  }

  const result = exactBootstrap ? buildSummaryFromBootstrap(exactBootstrap, maxRecent) : buildColdStart(projectPath, inferredProjectKey, currentCheckpoint);
  result.checkpoint_resolver = currentCheckpoint;
  if (currentCheckpoint.state !== "not_adopted" && currentCheckpoint.ok !== true) result.open_loops = [];
  result.project_key = inferredProjectKey;
  const payloadBytes = finalizeBootstrap(result, { reason, source: exactBootstrap ? "project_bootstrap" : "cold_start", summary_bytes: Buffer.byteLength(result.summary, "utf8"), max_bytes: BOOTSTRAP_MAX_BYTES, max_recent_sessions: maxRecent, deduplicated: false });
  bootstrapCache.set(cacheKey, { at: Date.now(), result });
  appendBootstrapEvent({ at: new Date().toISOString(), event: "bootstrap", project_key: inferredProjectKey, reason, source: result.telemetry.source, payload_bytes: payloadBytes, max_recent_sessions: maxRecent, deduplicated: false });
  return result;
}

